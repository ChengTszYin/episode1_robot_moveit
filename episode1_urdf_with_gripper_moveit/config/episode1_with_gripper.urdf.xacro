<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="episode1_with_gripper">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import episode1_with_gripper urdf file -->
    <xacro:include filename="$(find episode1_urdf_with_gripper)/urdf/episode1_gripper_attached.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="episode1_with_gripper.ros2_control.xacro" />


    <xacro:episode1_with_gripper_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
